{
  "compilerOptions": {
    "lib": ["es6", "ES2020"],
    "declaration": true,
    "declarationDir": "dist",
    "declarationMap": true,
    "module": "es6",
    "target": "es6",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "typeRoots": ["node_modules/@types"],
    "rootDir": "src"
  },
}
